<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Library</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <nav>
      <div class="nbar logo">Library</div>
      <div>
        <% if (user) { %>
        <div class="nbar">
          <% if (user.role === "admin") { %>
          <div class="btn"><a href="/admin/logs">Logs</a></div>
          <% } %>
          <form action="/logout" method="POST"><button type="submit" class="btn">Log out</button></form>
        </div>
        <% } else { %>
        <div class="nbar">
          <div class="btn"><a href="/register">Register</a></div>
          <div class="btn"><a href="/login">Log in</a></div>
        </div>
        <% } %>
      </div>
    </nav>
    <div class="public-books">
      <h1>Discover</h1>
      <% if (publicBooks.length === 0) { %>
      <p>No public books yet.</p>
      <% } else { %>
      <ul class="book-list">
        <% publicBooks.forEach(book => { %>
        <li class="book">
          <a href="/book?id=<%= book.id %>">
            <span class="book-title"><%= book.title %></span>
            <span class="book-owner">by <%= book.owner %></span>
          </a>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
    <div class="user-books">
      <h1>Your books</h1>
      <% if (!user) { %>
      <p>You need to <a href="/login">log in</a> to upload books.</p>
      <% } else { %>
      <div class="btn upload-btn"><a href="/upload">Upload a book</a></div>
      <% if (userBooks.length === 0) { %>
      <p>You haven't uploaded any books yet.</p>
      <% } else { %>
      <ul class="book-list">
        <% userBooks.forEach(book => { %>
        <li class="book">
          <a href="/book?id=<%= book.id %>">
            <span class="book-title"><%= book.title %></span>
            <span class="book-owner"><%= book.is_public ? "Public" : "Private" %></span>
          </a>
          <div class="book-actions">
            <form action="/book/visibility" method="POST">
              <input type="hidden" name="id" value="<%= book.id %>" />
              <button type="submit" class="btn small"><%= book.is_public ? "Make private" : "Make public" %></button>
            </form>
            <form action="/book/delete" method="POST" onsubmit="return confirm('Delete this book?')">
              <input type="hidden" name="id" value="<%= book.id %>" />
              <button type="submit" class="btn small">Delete</button>
            </form>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <% } %>
    </div>
  </body>
</html>
