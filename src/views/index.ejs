<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Library</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <nav>
      <div class="nbar">Library</div>
      <div>
        <% if (user) { %>
        <form class="nbar" action="/logout" method="POST"><button type="submit">Log out</button></form>
        <% } else { %>
        <div class="nbar">
          <div><a href="/register">Register</a></div>
          <div><a href="/login">Log in</a></div>
        </div>
        <% } %>
      </div>
    </nav>
  </body>
</html>
