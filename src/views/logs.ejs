<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logs</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <nav>
      <div class="nbar logo"><a href="/" style="color: inherit; text-decoration: none">Library</a></div>
    </nav>
    <div class="public-books">
      <h1>Security log</h1>
      <table class="log-table">
        <tr><th>Time (UTC)</th><th>Event</th><th>User</th><th>IP</th><th>Details</th></tr>
        <% logs.forEach(log => { %>
        <tr>
          <td><%= log.time %></td>
          <td><%= log.event %></td>
          <td><%= log.username || "-" %></td>
          <td><%= log.ip || "-" %></td>
          <td><%= log.details || "" %></td>
        </tr>
        <% }) %>
      </table>
    </div>
  </body>
</html>